<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

<!-- Internal Template -->


    <Frame type="Frame" name="FactionButtonFrameTemplate">
        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
        <Height val="608"/>
        <Width val="648"/>
        
        <Visible val="false"/>
        <Enabled val="false"/>
        <Frame type="AspectRatioFrame" name="FactionButtonAspectRatioFrame">
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Width val="70"/>
            <CollapseLayout val="true"/>
            <MinVisibleAspectRatio val="1.5"/>
        </Frame>
        
        <Frame type="Portrait" name="FactionButtonPortrait" template="LotV_ArmyUpgradeUI/ArmyFactionButtonPortraitTemplate">
            <Anchor side="Top" relative="$parent/FactionButton" pos="Min" offset="-260"/>
            <Anchor side="Left" relative="$parent/FactionButton" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/FactionButton" pos="Mid" offset="0"/>
        </Frame>

        <Frame type="Button" name="FactionButton" template="LotV_ArmyUpgradeUI/ArmyFactionButtonTemplate">
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-100"/>
            <Anchor side="Left" relative="$parent/FactionButtonAspectRatioFrame" pos="Max" offset="0"/>
            <Visible val="False"/>
        </Frame>
        
        
        <Frame type="Image" name="FactionLockedImage">
            <Anchor side="Bottom" relative="$parent/FactionButton" pos="Mid" offset="50"/>
            <Anchor side="Left" relative="$parent/FactionButton" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/FactionButton" pos="Max" offset="0"/>
            <Texture val="@UI/LotV_StoryMode_ArmyUpgrade_Faction_Locked"/>			
            <Width val="124"/>
            <Height val="140"/>
            <DesaturateOnDisable val="false"/>
            <Visible val="False"/>
        </Frame>
        
        <StateGroup name="ConditionalVisibility">
            <DefaultState val="Hidden"/>
            <State name="VisibleFromUnlocked">
                <When type="Property" frame="$this/FactionButton" Enabled="True"/>
                <Action type="SetProperty" frame="$this" Enabled="True"/>
                <Action type="SetProperty" frame="$this" Visible="True"/>
            </State>
            <State name="VisibleFromLocked">
                <When type="Property" frame="$this/FactionLockedImage" Enabled="True"/>
                <Action type="SetProperty" frame="$this" Enabled="True"/>
                <Action type="SetProperty" frame="$this" Visible="True"/>
            </State>
            <State name="Hidden">
                <When type="Property" frame="$this/FactionButton" Enabled="False"/>
                <When type="Property" frame="$this/FactionLockedImage" Enabled="False"/>
                <Action type="SetProperty" frame="$this" Enabled="False"/>
            </State>
        </StateGroup>

        <StateGroup name="RatioRescaling">
            <DefaultState val="Scaled"/>
            <State name="Scaled">
                <When type="Property" frame="$this/FactionButtonAspectRatioFrame" Visible="True"/>
                <Action type="SetProperty" frame="$this" Width="518"/>
            </State>
            <State name="Unscaled">
                <When type="Property" frame="$this/FactionButtonAspectRatioFrame" Visible="False"/>
                <Action type="SetProperty" frame="$this" Width="448"/>
            </State>
        </StateGroup>
        <CollapseLayout val="true"/>
    </Frame>


    <Frame type="Frame" name="FactionButtonPageTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <CollapseLayout val="False"/>
            <Frame type="Frame" name="FactionButtonFrame1" template="LotV_ArmyUpgradeOverride/FactionButtonFrameTemplate">
                <Anchor side="Left" relative="$parent" pos="Min" offset="50"/> 
                <Anchor side="Right" relative="$parent" pos="Min" offset="703"/>  
            </Frame>
            <Frame type="Frame" name="FactionButtonFrame2" template="LotV_ArmyUpgradeOverride/FactionButtonFrameTemplate">
                <Anchor side="Left" relative="$parent/FactionButtonFrame1" pos="Max" offset="-422"/>
                <Anchor side="Right" relative="$parent/FactionButtonFrame1" pos="Max" offset="226"/>  
            </Frame>
            <Frame type="Frame" name="FactionButtonFrame3" template="LotV_ArmyUpgradeOverride/FactionButtonFrameTemplate">
                <Anchor side="Left" relative="$parent/FactionButtonFrame2" pos="Max" offset="-422"/>
                <Anchor side="Right" relative="$parent/FactionButtonFrame2" pos="Max" offset="226"/>  
            </Frame>
            <Frame type="Frame" name="FactionButtonFrame4" template="LotV_ArmyUpgradeOverride/FactionButtonFrameTemplate">
                <Anchor side="Left" relative="$parent/FactionButtonFrame3" pos="Max" offset="-422"/>
                <Anchor side="Right" relative="$parent/FactionButtonFrame3" pos="Max" offset="226"/>  
            </Frame>

            <StateGroup name="AutoSpacing">
                <DefaultState val="Slot4"/>
                <State name="Slot1">
                    <When type="Property" frame="$this/FactionButtonFrame1" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame2" Enabled="False"/>
                    <When type="Property" frame="$this/FactionButtonFrame3" Enabled="False"/>
                    <When type="Property" frame="$this/FactionButtonFrame4" Enabled="False"/>
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame1" side="Left" relative="$parent" pos="Min" offset="343"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame1" side="Right" relative="$parent" pos="Min" offset="991"/> 
                    <Action type="SetProperty" frame="$this/FactionButtonFrame1/FactionButtonAspectRatioFrame" Width="100"/> 
                </State>
                <State name="Slot2">
                    <When type="Property" frame="$this/FactionButtonFrame1" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame2" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame3" Enabled="False"/>
                    <When type="Property" frame="$this/FactionButtonFrame4" Enabled="False"/>
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame1" side="Left" relative="$parent" pos="Min" offset="160"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame1" side="Right" relative="$parent" pos="Min" offset="808"/>  
                    <Action type="SetProperty" frame="$this/FactionButtonFrame1/FactionButtonAspectRatioFrame" Width="100"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame2" side="Left" relative="$parent/FactionButtonFrame1" pos="Max" offset="-275"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame2" side="Right" relative="$parent/FactionButtonFrame1" pos="Max" offset="373"/> 
                    <Action type="SetProperty" frame="$this/FactionButtonFrame2/FactionButtonAspectRatioFrame" Width="100"/> 
                </State>
                <State name="Slot3">
                    <When type="Property" frame="$this/FactionButtonFrame1" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame2" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame3" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame4" Enabled="False"/>
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame1" side="Left" relative="$parent" pos="Min" offset="75"/>
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame1" side="Right" relative="$parent" pos="Min" offset="723"/>  
                    <Action type="SetProperty" frame="$this/FactionButtonFrame1/FactionButtonAspectRatioFrame" Width="70"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame2" side="Left" relative="$parent/FactionButtonFrame1" pos="Max" offset="-350"/>
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame2" side="Right" relative="$parent/FactionButtonFrame1" pos="Max" offset="298"/> 
                    <Action type="SetProperty" frame="$this/FactionButtonFrame2/FactionButtonAspectRatioFrame" Width="70"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame3" side="Left" relative="$parent/FactionButtonFrame2" pos="Max" offset="-350"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame3" side="Right" relative="$parent/FactionButtonFrame2" pos="Max" offset="298"/> 
                    <Action type="SetProperty" frame="$this/FactionButtonFrame3/FactionButtonAspectRatioFrame" Width="70"/> 
                </State>
                <State name="Slot4">
                    <When type="Property" frame="$this/FactionButtonFrame1" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame2" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame3" Enabled="True"/>
                    <When type="Property" frame="$this/FactionButtonFrame4" Enabled="True"/>
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame1" side="Left" relative="$parent" pos="Min" offset="52"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame1" side="Right" relative="$parent" pos="Min" offset="700"/>   
                    <Action type="SetProperty" frame="$this/FactionButtonFrame1/FactionButtonAspectRatioFrame" Width="50"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame2" side="Left" relative="$parent/FactionButtonFrame1" pos="Max" offset="-422"/>
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame2" side="Right" relative="$parent/FactionButtonFrame1" pos="Max" offset="226"/> 
                    <Action type="SetProperty" frame="$this/FactionButtonFrame2/FactionButtonAspectRatioFrame" Width="50"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame3" side="Left" relative="$parent/FactionButtonFrame2" pos="Max" offset="-422"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame3" side="Right" relative="$parent/FactionButtonFrame2" pos="Max" offset="226"/> 
                    <Action type="SetProperty" frame="$this/FactionButtonFrame3/FactionButtonAspectRatioFrame" Width="50"/> 
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame4" side="Left" relative="$parent/FactionButtonFrame3" pos="Max" offset="-422"/>
                    <Action type="SetAnchor" frame="$this/FactionButtonFrame4" side="Right" relative="$parent/FactionButtonFrame3" pos="Max" offset="226"/> 
                    <Action type="SetProperty" frame="$this/FactionButtonFrame4/FactionButtonAspectRatioFrame" Width="50"/> 
                </State>
            </StateGroup>

    </Frame>
<!-- End Internal Template -->

    <Frame type="Frame" name="ArmyUpgradeOverrideTemplate" template="LotV_ArmyUpgradeUI/ArmyUpgradeTemplate">
        <Frame type="ProgressBar" name="HoloModelRotation">
            <MaxValue val="1"/>
            <MinValue val="0"/>
            <Value val="1"/>
        </Frame>
        <Frame type="UnitModelFrame" name="HoloModel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-80"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-80"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/> 
            <TurningEnabled val="true"/>
            <Frame type="Model" name="Model">
                <Anchor relative="$parent"/>
                <UseAspectScaling val="false"/>
            </Frame>
            <Visible val="false"/>
            <StateGroup name="AutoTurningCheck">
                <DefaultState val="AutoTurning"/>
                <State name="AutoTurning">
                    <When type="Property" frame="$parent/HoloModelRotation" Value="1"/>
                    <Action type="SetProperty" frame="$this" TurningEnabled="True"/> 
                </State>
                <State name="NoAutoTurning">
                    <When type="Property" frame="$parent/HoloModelRotation" Value="0"/>
                    <Action type="SetProperty" frame="$this" TurningEnabled="False"/> 
                </State>
    
            </StateGroup>
        </Frame>
        
        <Frame type="Frame" name="FactionChoiceFrame">    
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-5"/> 
            <!-- Hide native FactionChoice Button -->      
            <Frame type="Portrait" name="FactionButtonPortrait1" template="LotV_ArmyUpgradeUI/ArmyFactionButtonPortraitTemplate">
                <Visible val="false"/>
            </Frame>
            <Frame type="Button" name="FactionButton1" template="LotV_ArmyUpgradeUI/ArmyFactionButtonTemplate">
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                <Anchor side="Right" relative="$parent/FactionButton1AspectRatioFrame" pos="Min" offset="0"/>
                <Visible val="false"/>
            </Frame>
            
            <Frame type="AspectRatioFrame" name="FactionButton1AspectRatioFrame">
                <Visible val="false"/>
            </Frame>
            
            <Frame type="Portrait" name="FactionButtonPortrait2" template="LotV_ArmyUpgradeUI/ArmyFactionButtonPortraitTemplate">
                <Visible val="false"/>
            </Frame>
            
            <Frame type="Button" name="FactionButton2" template="LotV_ArmyUpgradeUI/ArmyFactionButtonTemplate">
                <Visible val="false"/>
            </Frame>
            
            <Frame type="AspectRatioFrame" name="FactionButton3AspectRatioFrame">
                <Visible val="false"/>
            </Frame>
            
            <Frame type="Portrait" name="FactionButtonPortrait3" template="LotV_ArmyUpgradeUI/ArmyFactionButtonPortraitTemplate">
                <Visible val="false"/>
            </Frame>
            
            <Frame type="Button" name="FactionButton3" template="LotV_ArmyUpgradeUI/ArmyFactionButtonTemplate">
                <Visible val="false"/>
             </Frame>
            
            <Frame type="Image" name="Faction3LockedImage">
                <Visible val="false"/>
            </Frame>

            <!-- Add (Custom) adaptative FactionChoice Button -->
            <Frame type="Button" name="FactionChoicePageSelect" template="StandardTemplates/StandardButtonTemplate">
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                <Anchor side="Top" relative="$parent" pos="Min" offset="105"/>
                <CollapseLayout val="False"/>
                <Visible val="False"/>
                <Width val="225"/>
                <Height val="45"/>
                <Frame type="Label" name="Label">
                    <Text val="Change Page"/>
                </Frame>

                <Frame type="Image" name="NormalImage">
                    <Texture val="Assets/Textures/ui_void_storybutton_small_normalpressed.dds"/>
                </Frame>

                <Frame type="Image" name="HoverImage">
                    <Texture val="Assets/Textures/ui_void_storybutton_small_normaloverpressedover.dds"/>
                </Frame>
                
            </Frame> 

            <Frame type="Frame" name="FactionButtonPage1" template="LotV_ArmyUpgradeOverride/FactionButtonPageTemplate">
            </Frame>
            <Frame type="Frame" name="FactionButtonPage2" template="LotV_ArmyUpgradeOverride/FactionButtonPageTemplate">
            </Frame>
            <Frame type="Frame" name="FactionButtonPage3" template="LotV_ArmyUpgradeOverride/FactionButtonPageTemplate">
            </Frame>
            <Frame type="Frame" name="FactionButtonPage4" template="LotV_ArmyUpgradeOverride/FactionButtonPageTemplate">
            </Frame>


            <StateGroup name="PageSelectorVisibility">
                <DefaultState val="Hidden"/>
                <State name="Hidden">
                    <When type="Property" frame="$this/FactionButtonPage2/FactionButtonFrame1" Enabled="False"/>
                    <Action type="SetProperty" frame="$this/FactionChoicePageSelect" Visible="False"/>
                </State>
                <State name="Visible5">
                    <When type="Property" frame="$this/FactionButtonPage2/FactionButtonFrame1" Enabled="True"/>
                    <Action type="SetProperty" frame="$this/FactionChoicePageSelect" Visible="True"/>
                </State>
            </StateGroup> 
        </Frame>
    </Frame>
</Desc>
